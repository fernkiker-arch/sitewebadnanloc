# PostgreSQL container owner. Used only by Docker and the migration command.
POSTGRES_DB=swiftxpress
POSTGRES_OWNER_USER=swiftxpress_owner
POSTGRES_OWNER_PASSWORD=replace-with-a-long-local-owner-password
POSTGRES_APP_PASSWORD=replace-with-a-long-local-app-password
POSTGRES_PORT=5432

# Runtime URL uses the restricted application role. Keep credentials URL-encoded.
DATABASE_URL=postgresql://swiftxpress_app:replace-with-a-long-local-app-password@localhost:5432/swiftxpress
DATABASE_ADMIN_URL=postgresql://swiftxpress_owner:replace-with-a-long-local-owner-password@localhost:5432/swiftxpress
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=5

# Quote endpoint protection. Generate a unique, random value for production.
RATE_LIMIT_SALT=replace-with-at-least-32-random-characters
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=900
ALLOWED_ORIGINS=http://localhost:3000,https://swiftxpress.ca,https://www.swiftxpress.ca
